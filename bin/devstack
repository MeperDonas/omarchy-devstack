#!/usr/bin/env bash
# devstack — levanta, mira y baja stacks de desarrollo locales con un solo comando.
#
# Cada proyecto se declara en un JSON (~/.config/devstack/<proyecto>.json):
# servicios docker o de proceso, puerto, health-check, tareas extra. El script
# orquesta docker, los servidores de desarrollo y el navegador; los servicios
# viven en un pidfile propio para que `down` no deje nada huérfano y para no
# tocar nunca un proceso que hayas levantado tú a mano.
#
# Uso:
#   devstack                          lista los proyectos configurados
#   devstack <p> [up]                 levanta todo y abre el navegador
#                                     --force pisa lo ajeno que ocupe los puertos
#   devstack <p> down                 baja los procesos y los servicios docker
#                                     --keep-docker lo deja, --force mata lo ajeno
#   devstack <p> restart [id...]      reinicia (todos o los ids dados)
#   devstack <p> status               estado por servicio
#   devstack <p> json                 estado como JSON (lo consume el widget de la barra)
#   devstack <p> logs [id]            sigue los logs (o los últimos de todos)
#   devstack <p> open [id]            abre la URL del servicio (o la principal)
#   devstack <p> up <id...>           levanta sólo esos servicios (con dependencias)
#   devstack <p> task <id>            corre una tarea declarada (seed, migrate, …)
#   devstack <p> list                 servicios y tareas declarados
#   devstack <p> menu                 imprime el bloque JSONC para el menú de Omarchy
#   devstack <p> --running            exit 0 si todos los servicios con health responden
#   devstack <p> --up                 exit 0 si todo escucha
#   devstack <p> --foreign            exit 0 si algún puerto lo tiene un proceso ajeno
#
#   devstack init <p>                 crea el JSON de un proyecto desde una plantilla
#   devstack scan <dir>               propone el stack de un repo (no escribe nada)
#   devstack add <dir> [--name <n>]   declara el stack que propone `scan`
#                                     (repetirlo sobre el mismo dir no rompe)
#   devstack all [status|json|up|down]  todos TUS proyectos de una vez
#   devstack here [cmd] [--window] [--fallback <p>] [--default]
#                                     el proyecto de la terminal activa (--window) o del
#                                     $PWD, y reenvía ahí cmd: status, up, down, logs…
#   devstack find [DIR...] [--json]   busca en tus carpetas los repos con stack
#                                     detectable (no escribe nada)
#   devstack use [<p>|--clear]        proyecto de casa: el que se usa cuando no hay
#                                     otro (el widget lo usa si la terminal no está
#                                     en ningún proyecto declarado)
#
# Overrides: DEVDATA_CONFIG (dir de configs) DEVDATA_PROJECT (proyecto por defecto)
#            DEVDATA_NOTIFY=all|final|off  (avisos de escritorio; el widget usa final)
#            DEVDATA_WAIT_SCALE (multiplica las esperas)

set -euo pipefail

# Configs: el proyecto del usuario manda; los ejemplos que viajan DENTRO del
# plugin quedan de respaldo (el plugin se instala clonando el repo entero, así
# que `omarchy plugin add` ya trae el CLI y los ejemplos de una sola vez).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
USER_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/devstack"
BUNDLED_CONFIG_DIR="$SCRIPT_DIR/../config"
# Capa de detección (lib/scan.sh). Vive junto al CLI en el repo/plugin; si el
# CLI se copió suelto a ~/.local/bin, install.sh la deja en ~/.local/share/devstack.
SCAN_LIB=""
for cand in "$SCRIPT_DIR/../lib/scan.sh" "$SCRIPT_DIR/lib/scan.sh" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/devstack/lib/scan.sh" "$HOME/.local/lib/devstack/scan.sh"; do
    [[ -r $cand ]] && { SCAN_LIB=$cand; break; }
done

CONFIG_DIRS=()
[[ -n ${DEVDATA_CONFIG:-} ]] && CONFIG_DIRS+=("$DEVDATA_CONFIG")
CONFIG_DIRS+=("$USER_CONFIG_DIR")
[[ -d $BUNDLED_CONFIG_DIR ]] && CONFIG_DIRS+=("$BUNDLED_CONFIG_DIR")
# Estado por usuario: bajo XDG_RUNTIME_DIR cuando existe; si no, un directorio
# propio con el uid (una ruta predecible y compartida en /tmp es lo que el
# baseline de seguridad del marketplace marca).
if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    RUNTIME_BASE="$XDG_RUNTIME_DIR/devstack"
else
    RUNTIME_BASE="/tmp/devstack-$(id -u)"
fi
DEFAULT_PROJECT="${DEVDATA_PROJECT:-}"
WAIT_SCALE="${DEVDATA_WAIT_SCALE:-1}"
CURRENT=""
CONFIG_FILE=""

# ---------------------------------------------------------------- salida

log()  { printf '\033[1;34m[pos]\033[0m  %s\n' "$*"; }
ok()   { printf '\033[1;32m[ok]\033[0m   %s\n' "$*"; }
warn() { printf '\033[1;33m[aviso]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; notify_result "Error: $*"; exit 1; }

# Modo de avisos: `all` (cada etapa, por defecto), `final` (sólo el resultado)
# u `off`. El widget de la barra usa `final`: el panel ya muestra el progreso, y
# las notificaciones de cada etapa caían encima del propio panel.
NOTIFY_MODE="${DEVDATA_NOTIFY:-all}"

_notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    # Un estado de error se consulta cada pocos segundos (la barra hace `json`):
    # el mismo mensaje se avisa como mucho una vez por minuto, si no te llena de
    # notificaciones. Los mensajes distintos siempre pasan.
    local stamp="$RUNTIME_BASE/.last-notify" now last_at=0 last_msg=""
    now=$(date +%s)
    if [[ -r $stamp ]]; then
        IFS=$'\t' read -r last_at last_msg <"$stamp" || true
    fi
    [[ $last_at =~ ^[0-9]+$ ]] || last_at=0
    if [[ "$1" == "$last_msg" ]] && ((now - last_at < 60)); then
        return 0
    fi
    ensure_runtime 2>/dev/null || return 0
    printf '%s\t%s\n' "$now" "$1" >"$stamp" 2>/dev/null || true
    notify-send "${DEVDATA_NAME:-devstack}" "$1" >/dev/null 2>&1 || true
}

# Progreso (etapas): se calla en modo `final`.
notify() {
    [[ $NOTIFY_MODE == all ]] || return 0
    _notify "$1"
}

# Resultado (listo, parcial, error): pasa salvo en modo `off`.
notify_result() {
    [[ $NOTIFY_MODE == off ]] && return 0
    _notify "$1"
}

# El estado (pidfiles, logs) tiene que ser del usuario y privado. Si no hay
# XDG_RUNTIME_DIR caemos en /tmp/devstack-<uid> y lo verificamos antes de
# escribir: una ruta predecible en /tmp que otro usuario pueda pre-crear es
# justo lo que el baseline de seguridad del marketplace marca.
ensure_runtime() {
    if [[ ! -d $RUNTIME_BASE ]]; then
        mkdir -p "$RUNTIME_BASE" 2>/dev/null || die "No puedo crear $RUNTIME_BASE"
    fi
    [[ -O $RUNTIME_BASE ]] || die "$RUNTIME_BASE no es mío; no escribo ahí"
    chmod 700 "$RUNTIME_BASE" 2>/dev/null || true
}

# ---------------------------------------------------------------- sondas

port_open() { ss -ltnH "sport = :$1" 2>/dev/null | grep -q .; }

# PID dueño de un puerto (visible si el proceso es del mismo usuario). Siempre
# termina en 0: un grep sin match no debe tumbar el script (set -e).
port_owner() {
    ss -ltnpH "sport = :$1" 2>/dev/null | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2 || true
}

http_code() { curl -sS -o /dev/null -m "${2:-2}" -w '%{http_code}' "$1" 2>/dev/null || printf '000'; }
http_ok() { [[ "$(http_code "$1" "${2:-2}")" =~ ^[23] ]]; }

pid_of_file() {
    local f=$1 pid
    [[ -r $f ]] || return 1
    pid=$(<"$f")
    [[ $pid =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s' "$pid"
}

# ---------------------------------------------------------------- config

list_projects() {
    local dir f name seen=""
    for dir in "${CONFIG_DIRS[@]}"; do
        for f in "$dir"/*.json; do
            [[ -r $f ]] || continue
            name=$(basename "$f" .json)
            [[ " $seen " == *" $name "* ]] && continue
            seen="$seen $name"
            printf '%s\n' "$name"
        done
    done
}

# Ruta del config de un proyecto: se busca en orden (usuario primero).
project_file() {
    local name=$1 dir
    for dir in "${CONFIG_DIRS[@]}"; do
        [[ -r "$dir/$name.json" ]] && {
            printf '%s' "$dir/$name.json"
            return 0
        }
    done
    return 1
}

# Proyecto "de casa": el que guarda `devstack use`. Si el archivo apunta a un
# proyecto que ya no existe devuelve error en vez de morir: lo usan `here` y el
# widget, donde caerse no es opción.
default_project() {
    local f="$USER_CONFIG_DIR/default" name
    [[ -r $f ]] || return 1
    name=$(<"$f")
    [[ -n $name ]] || return 1
    project_file "$name" >/dev/null || return 1
    printf '%s' "$name"
}

use_cmd() {
    local f="$USER_CONFIG_DIR/default" want="${1:-}" cur
    case $want in
        --help | -h)
            printf 'devstack use [PROYECTO|--clear]\n'
            printf '  sin argumentos  muestra el proyecto de casa\n'
            printf '  PROYECTO        lo guarda (el widget lo usa cuando la terminal no está\n'
            printf '                  en ningún proyecto declarado)\n'
            printf '  --clear         lo olvida y vuelve a depender de la lectura automática\n'
            return 0
            ;;
        --clear)
            rm -f "$f"
            ok "Sin proyecto de casa: el widget vuelve a seguir la terminal"
            return 0
            ;;
        "")
            if cur=$(default_project); then
                printf '%s\n' "$cur"
            elif [[ -r $f ]]; then
                warn "El proyecto guardado ('$(<"$f")') ya no existe: corré 'devstack use --clear'"
                return 1
            else
                printf 'Sin proyecto de casa\n'
            fi
            return 0
            ;;
    esac
    project_file "$want" >/dev/null || die "No existe el proyecto '$want' (busqué en ${CONFIG_DIRS[*]})"
    mkdir -p "$USER_CONFIG_DIR"
    printf '%s\n' "$want" >"$f"
    ok "Proyecto de casa: $want (el widget lo usa cuando no reconoce la terminal)"
}

# devstack find [DIR...] [--json] [--depth N]
# Busca en tus carpetas de proyectos los repos que devstack podría levantar:
# nombre, ruta, si ya está declarado y cuántos servicios salen. No escribe nada
# (para declarar uno: `devstack add <dir>`). Es la versión "elegí vos" del
# detector: la lista de candidatos que el widget muestra al buscar.
find_cmd() {
    local roots=() opt="" depth=2
    while [[ $# -gt 0 ]]; do
        case $1 in
            --json) opt=--json ;;
            --depth)
                shift
                depth=${1:-2}
                ;;
            -*) die "find: opción desconocida $1" ;;
            *) roots+=("$1") ;;
        esac
        shift
    done
    if ((${#roots[@]} == 0)); then
        # DEVDATA_SEARCH_ROOTS con ':' separa varias carpetas.
        IFS=':' read -r -a roots <<<"${DEVDATA_SEARCH_ROOTS:-$HOME/Projects}"
    fi
    require_scan
    # Dónde están TUS proyectos ya declarados: un directorio que ya es un
    # proyecto (o vive dentro de uno) no se propone como candidato aparte.
    local decl_paths=() decl_names=() p d i
    while IFS= read -r p; do
        [[ -n $p ]] || continue
        d=$(jq -r '.dir // ""' "$(project_file "$p")" 2>/dev/null)
        d="${d/#\~/$HOME}"
        d=$(cd "$d" 2>/dev/null && pwd) || d="${d%/}"
        [[ -n $d ]] || continue
        decl_paths+=("$d")
        decl_names+=("$p")
    done < <(list_user_projects)

    local root dir json rows="[]" entry name label declared skipped candidates=() prev n
    for root in "${roots[@]}"; do
        [[ -d $root ]] || continue
        root=$(cd "$root" && pwd)
        while IFS= read -r dir; do
            # Si ya acepté la carpeta madre, sus hijos no son otro proyecto.
            for prev in ${candidates[@]+"${candidates[@]}"}; do
                [[ $dir == "$prev"/* ]] && continue 2
            done

            declared=""
            skipped=""
            for ((i = 0; i < ${#decl_paths[@]}; i++)); do
                if [[ $dir == "${decl_paths[$i]}" ]]; then
                    declared="${decl_names[$i]}"
                    break
                fi
                if [[ $dir == "${decl_paths[$i]}"/* ]]; then
                    skipped=1
                    break
                fi
            done
            [[ -n $skipped ]] && continue

            rel=${dir#"$root"/}
            if [[ -n $declared ]]; then
                # Ya declarado: su estado (y sus servicios) salen del proyecto,
                # no del detector. Se acepta acá y se podan sus hijos.
                candidates+=("$dir")
                entry=$(project_snapshot "$declared" | jq -c --arg dir "$dir" --arg l "$rel" --arg d "$declared" \
                    '{name: .name, dir: $dir, label: $l, suggested: $d, declared: true, project: $d,
                      services: .services, docker: 0, up: .up, total: .total, allUp: .allUp}')
            else
                # El detector decide: si de acá salen servicios, es un proyecto
                # (aunque su stack viva en backend/ y frontend/).
                json=$(scan_project_json "$dir" "" 2>/dev/null | grep -v '^#') || continue
                [[ -n $json ]] || continue
                n=$(printf '%s' "$json" | jq '.services | length')
                ((n > 0)) || continue
                # Un candidato tiene que parecer un repo (marcador en la raíz) o
                # traer un stack de verdad (2+ servicios): así un directorio
                # contenedor con un solo service suelto no se come a los
                # proyectos que tiene adentro.
                if ((n < 2)) && ! looks_like_repo "$dir"; then continue; fi
                name=$(sanitize_name "$rel")
                candidates+=("$dir")
                entry=$(printf '%s' "$json" | jq -c --arg dir "$dir" --arg l "$rel" --arg p "$name" \
                    '{name: (.name // $p), dir: $dir, label: $l, suggested: $p, declared: false, project: "",
                      services: [.services[]? | {id: .id, label: .label, type: .type, port: .port}],
                      docker: ([.services[]? | select(.type == "docker")] | length), up: 0, total: 0, allUp: false}')
            fi
            rows=$(printf '%s' "$rows" | jq -c --argjson e "$entry" '. + [$e]')
        done < <(find "$root" -mindepth 1 -maxdepth "$depth" -type d \
            -not -path '*/.git*' -not -path '*/node_modules*' -not -path '*/dist*' \
            -not -path '*/.next*' -not -path '*/build*' -not -path '*/target*' \
            -not -path '*/vendor*' -not -path '*/.venv*' -not -path '*/__pycache__*' 2>/dev/null | sort)
    done

    # Primero los que ya podés levantar, después los que traen más servicios.
    rows=$(printf '%s' "$rows" | jq -c 'sort_by([(if .declared then 0 else 1 end), (if .declared then 0 else -(.services | length) end), (.label // "")])')
    if [[ $opt == --json ]]; then
        printf '%s\n' "$rows"
        return 0
    fi
    if [[ $(printf '%s' "$rows" | jq 'length') -eq 0 ]]; then
        warn "No encontré repos con stack en: ${roots[*]}"
        return 1
    fi
    printf '%s' "$rows" | jq -r '.[] |
        [(if .declared then "declarado" else "sin declarar" end), .label,
         (if .declared then ((.total | tostring) + " serv.") else ((.services | length) | tostring) + " serv." end),
         (if .docker > 0 then "docker" else "" end), .dir] | @tsv' \
        | column -t -s$'\t'
    printf '\nPara declarar uno: devstack add <ruta>  ·  para levantarlo ya: devstack add <ruta> && devstack <nombre> up\n'
}

resolve_project() {
    local want="${1:-$DEFAULT_PROJECT}" all=()
    if [[ -z $want ]]; then
        while IFS= read -r p; do [[ -n $p ]] && all+=("$p"); done < <(list_projects)
        case ${#all[@]} in
            0) die "No hay proyectos: corré 'devstack init NOMBRE' o poné un .json en $USER_CONFIG_DIR" ;;
            1) want="${all[0]}" ;;
            *)
                if [[ -r $USER_CONFIG_DIR/default ]]; then
                    want=$(<"$USER_CONFIG_DIR/default")
                else
                    die "Hay varios proyectos (${all[*]}): pasá el nombre o corré 'devstack use <nombre>'"
                fi
                ;;
        esac
    fi
    project_file "$want" >/dev/null || die "No existe el proyecto '$want' (busqué en ${CONFIG_DIRS[*]})"
    printf '%s' "$want"
}

load_project() {
    CURRENT=$(resolve_project "${1:-}")
    CONFIG_FILE=$(project_file "$CURRENT")
    command -v jq >/dev/null || die "Falta jq (pacman -S jq)"
    DEVDATA_NAME=$(jq -r '.name // env.DEVDATA_NAME // "devstack"' "$CONFIG_FILE")
    DIR=$(jq -r '.dir // "."' "$CONFIG_FILE")
    DIR="${DIR/#\~/$HOME}"
    RUNTIME_DIR="$RUNTIME_BASE/$CURRENT"
    [[ -d $DIR ]] || warn "El directorio del proyecto no existe: $DIR"
}

# Lee un campo de un servicio: svc_field <id> <campo>
svc_field() {
    jq -r --arg id "$1" --arg k "$2" '.services[] | select(.id == $id) | .[$k] // empty' "$CONFIG_FILE"
}
svc_ids() { jq -r '.services[].id' "$CONFIG_FILE"; }
svc_index() { jq -r --arg id "$1" '.services | to_entries[] | select(.value.id == $id) | .key' "$CONFIG_FILE"; }

svc_label() { local l; l=$(svc_field "$1" label); printf '%s' "${l:-$1}"; }
svc_port() { svc_field "$1" port; }
svc_type() { local t; t=$(svc_field "$1" type); printf '%s' "${t:-process}"; }
svc_pidfile() { printf '%s/%s.pid' "$RUNTIME_DIR" "$1"; }
svc_logfile() { printf '%s/%s.log' "$RUNTIME_DIR" "$1"; }

# Une un directorio base con el valor declarado, respetando rutas absolutas.
join_dir() {
    local base=$1 value=$2
    if [[ -z $value ]]; then
        printf '%s' "$base"
    elif [[ $value == /* ]]; then
        printf '%s' "$value"
    else
        printf '%s/%s' "$base" "$value"
    fi
}

# Ruta absoluta de un campo de directorio del servicio, relativa al proyecto.
svc_dir() {
    join_dir "$DIR" "$(svc_field "$1" dir)"
}

docker_needed() {
    local id
    for id in $(svc_ids); do
        [[ $(svc_type "$id") == docker ]] && return 0
    done
    return 1
}

# ---------------------------------------------------------------- docker

DOCKER=()
docker_resolved=""
resolve_docker() {
    [[ -n $docker_resolved ]] && return 0
    command -v docker >/dev/null || die "Docker no está instalado"
    if command -v omarchy-sudo-docker >/dev/null 2>&1 && omarchy-sudo-docker 2>/dev/null; then
        # Sin grupo docker el socket es root: con terminal pide la contraseña
        # sudo; sin terminal (barra/menú) usa el diálogo de polkit de Omarchy.
        if [[ -t 0 ]]; then
            command -v sudo >/dev/null || die "Falta sudo"
            DOCKER=(sudo docker)
        else
            command -v pkexec >/dev/null || die "Falta pkexec (paquete polkit)"
            DOCKER=(pkexec docker)
        fi
    else
        DOCKER=(docker)
    fi
    docker_resolved=1
}

dockerq() { resolve_docker; "${DOCKER[@]}" "$@"; }

# Lectura de estado sin elevar: ni status ni la barra deben abrir un diálogo.
docker_quiet() {
    if command -v omarchy-sudo-docker >/dev/null 2>&1 && omarchy-sudo-docker 2>/dev/null; then
        if sudo -n true 2>/dev/null; then sudo docker "$@"; else return 1; fi
    else
        docker "$@"
    fi
}

compose_up() {
    local id=$1 file
    file=$(svc_field "$id" compose)
    [[ -n $file ]] || die "El servicio docker '$id' necesita 'compose'"
    [[ $file == /* ]] || file="$DIR/$file"
    resolve_docker
    ( cd "$DIR" && "${DOCKER[@]}" compose -f "$file" up -d )
}

compose_down() {
    local id=$1 file
    file=$(svc_field "$id" compose)
    [[ $file == /* ]] || file="$DIR/$file"
    resolve_docker
    ( cd "$DIR" && "${DOCKER[@]}" compose -f "$file" down )
}

container_status() {
    local id=$1 name
    name=$(svc_field "$id" container)
    [[ -n $name ]] || return 0
    docker_quiet ps -a --filter "name=^/${name}\$" --format '{{.Status}}' 2>/dev/null | head -1 || true
}

# ---------------------------------------------------------------- esperas

scaled() { printf '%s' "$(( $1 * WAIT_SCALE ))"; }

wait_for_port() {
    local port=$1 timeout=$2 label=$3 i=0
    port_open "$port" && { ok "$label ya escuchaba en :$port"; return 0; }
    log "Esperando $label en :$port (hasta ${timeout}s)..."
    while ((i < timeout)); do
        if port_open "$port"; then
            ok "$label escuchando en :$port"
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    return 1
}

wait_for_http() {
    local url=$1 timeout=$2 label=$3 i=0
    log "Esperando $label ($url) hasta ${timeout}s..."
    while ((i < timeout)); do
        if http_ok "$url"; then
            ok "$label responde"
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    return 1
}

wait_port_closed() {
    local port=$1 i=0
    while ((i < 15)); do
        port_open "$port" || return 0
        sleep 0.5
        i=$((i + 1))
    done
    return 1
}

tail_log() {
    [[ -s $1 ]] || return 0
    printf '\033[1;33m--- últimas líneas de %s ---\033[0m\n' "$1" >&2
    tail -n 25 "$1" >&2
}

# ---------------------------------------------------------------- procesos

start_process() {
    local id=$1 label=$2 dir=$3
    shift 3
    ensure_runtime
    mkdir -p "$RUNTIME_DIR"
    chmod 700 "$RUNTIME_DIR"
    local logfile pidfile
    logfile=$(svc_logfile "$id")
    pidfile=$(svc_pidfile "$id")
    : >"$logfile"
    rm -f "$pidfile"
    # setsid: el servicio queda en su propia sesión (pgid == pid) para poder
    # matar el árbol entero de npm en `down`.
    ( cd "$dir" || exit 1; setsid nohup "$@" >>"$logfile" 2>&1 & echo $! >"$pidfile" )
    sleep 0.5
    pid_of_file "$pidfile" >/dev/null || {
        tail_log "$logfile"
        die "$label no arrancó"
    }
    log "$label iniciado (pid $(<"$pidfile")) → $logfile"
}

stop_process() {
    local id=$1 label=$2 port=$3 pid i=0
    if ! pid=$(pid_of_file "$(svc_pidfile "$id")"); then
        rm -f "$(svc_pidfile "$id")"
        if [[ -n $port ]] && port_open "$port"; then
            warn "$label escucha en :$port pero lo levantó otra cosa (una terminal tuya); no lo toco"
        else
            log "$label ya estaba detenido"
        fi
        return 0
    fi
    log "Deteniendo $label (pgid $pid)..."
    kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    while ((i < 20)) && kill -0 "$pid" 2>/dev/null; do
        sleep 0.5
        i=$((i + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$(svc_pidfile "$id")"
    [[ -n $port ]] && { wait_port_closed "$port" || warn "$label sigue escuchando en :$port"; }
    ok "$label detenido"
}

managed_process() { pid_of_file "$(svc_pidfile "$1")" >/dev/null; }

# Mata el proceso ajeno que tiene el puerto (sólo con --force). Lee el grupo
# ANTES de matar: después ps ya no lo encuentra y con set -e eso terminaba el
# script en silencio.
force_free_port() {
    local port=$1 label=$2 pid pgid own_pgid can_group=1 i=0
    [[ -n $port ]] || return 0
    port_open "$port" || return 0
    pid=$(port_owner "$port")
    if [[ -z $pid ]]; then
        warn "$label: :$port está ocupado por otro usuario; no puedo liberarlo"
        return 1
    fi
    pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    own_pgid=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ' || true)
    [[ $pgid =~ ^[0-9]+$ && $pgid != "$own_pgid" && $pgid != "$$" ]] || can_group=0

    log "Matando el $label ajeno (pid $pid) que tiene :$port..."
    kill -TERM "$pid" 2>/dev/null || true
    while ((i < 10)) && port_open "$port"; do
        sleep 0.5
        i=$((i + 1))
    done

    if port_open "$port" && ((can_group)); then
        log "Sigue ocupado: mando TERM al grupo $pgid"
        kill -TERM "-$pgid" 2>/dev/null || true
        i=0
        while ((i < 6)) && port_open "$port"; do
            sleep 0.5
            i=$((i + 1))
        done
    fi

    if port_open "$port"; then
        kill -KILL "$pid" 2>/dev/null || true
        ((can_group)) && kill -KILL "-$pgid" 2>/dev/null || true
        sleep 0.5
    fi

    if port_open "$port"; then
        warn "$label: :$port sigue ocupado"
        return 1
    fi
    ok "$label: :$port liberado"
}

# ---------------------------------------------------------------- servicios

svc_up() {
    local id=$1 label port type
    label=$(svc_label "$id")
    port=$(svc_port "$id")
    type=$(svc_type "$id")

    if [[ -n $port ]] && port_open "$port"; then
        if [[ $type == docker ]]; then
            local st
            st=$(container_status "$id")
            ok "$label ya escucha en :$port${st:+ (contenedor: $st)}"
        elif managed_process "$id"; then
            ok "$label ya corriendo (lo levantó este script)"
        else
            ok "$label ya escucha en :$port (ajeno${owner:+, pid $(port_owner "$port")}); no lo toco"
        fi
        return 0
    fi

    if [[ $type == docker ]]; then
        log "Levantando $label (docker compose)..."
        compose_up "$id" || die "docker compose up falló para $label"
        wait_for_port "$port" "$(scaled "$(svc_field "$id" wait || echo 60)")" "$label" || {
            compose_logs "$id" | tail -25 >&2 || true
            die "$label no abrió :$port"
        }
        notify "$label listo (:$port)"
        return 0
    fi

    local dir wait cmd
    dir=$(svc_dir "$id")
    wait=$(svc_field "$id" wait)
    cmd=$(svc_field "$id" cmd)
    [[ -n $cmd ]] || die "El servicio '$id' necesita 'cmd'"
    [[ -d $dir ]] || die "No existe el directorio de $label: $dir"
    log "Iniciando $label ($cmd)..."
    notify "Compilando $label…"
    # shellcheck disable=SC2086
    start_process "$id" "$label" "$dir" $cmd
    if [[ -n $port ]]; then
        wait_for_port "$port" "$(scaled "${wait:-120}")" "$label" || {
            tail_log "$(svc_logfile "$id")"
            die "$label no abrió :$port"
        }
    fi
    local health
    health=$(svc_field "$id" health)
    if [[ -n $health ]]; then
        local deadline
        deadline=$(scaled "${wait:-120}")
        wait_for_http "$health" "$deadline" "$label" || {
            tail_log "$(svc_logfile "$id")"
            die "$label no llegó a responder en ${deadline}s"
        }
        notify "$label respondiendo (:$port)"
    else
        notify "$label escuchando (:$port)"
    fi
}

compose_logs() {
    local id=$1 file
    file=$(svc_field "$id" compose)
    [[ $file == /* ]] || file="$DIR/$file"
    resolve_docker
    ( cd "$DIR" && "${DOCKER[@]}" compose -f "$file" logs )
}

svc_down() {
    local id=$1 label port type
    label=$(svc_label "$id")
    port=$(svc_port "$id")
    type=$(svc_type "$id")
    if [[ $type == docker ]]; then
        compose_down "$id" || die "docker compose down falló para $label"
        ok "$label detenido"
    else
        stop_process "$id" "$label" "$port"
    fi
}

# Servicios declarados, en orden de arranque.
all_ids() { svc_ids; }

up() {
    local force="" arg
    for arg in "$@"; do [[ $arg == --force ]] && force=1; done
    local started elapsed=/dev/null id
    started=$(date +%s)
    if [[ -n $force ]]; then
        for id in $(svc_ids); do
            { managed_process "$id" || force_free_port "$(svc_port "$id")" "$(svc_label "$id")"; } || true
        done
    fi
    for id in $(svc_ids); do
        svc_up "$id"
    done
    print_urls
    elapsed=$(( $(date +%s) - started ))
    if report_ready "$elapsed"; then
        open_url "$(open_service)"
    fi
}

down() {
    local keep="" force="" arg
    for arg in "$@"; do
        case $arg in
            --keep-docker) keep=1 ;;
            --force) force=1 ;;
        esac
    done
    if [[ -n $force ]]; then
        local id
        for id in $(svc_ids); do
            { managed_process "$id" || force_free_port "$(svc_port "$id")" "$(svc_label "$id")"; } || true
        done
    fi
    # Bajar en orden inverso; docker al final.
    local ids=() id
    while IFS= read -r id; do ids+=("$id"); done < <(svc_ids)
    local i
    for ((i = ${#ids[@]} - 1; i >= 0; i--)); do
        [[ -n $keep && $(svc_type "${ids[i]}") == docker ]] && continue
        svc_down "${ids[i]}"
    done
    ok "Listo"
    notify_result "Stack detenido"
}

restart() {
    local force="" targets=() arg started elapsed
    for arg in "$@"; do
        case $arg in
            --force) force=1 ;;
            *) targets+=("$arg") ;;
        esac
    done
    started=$(date +%s)
    if [[ ${#targets[@]} -eq 0 ]]; then
        for arg in $(svc_ids); do targets+=("$arg"); done
    fi
    if [[ -n $force ]]; then
        local id
        for id in "${targets[@]}"; do
            { managed_process "$id" || force_free_port "$(svc_port "$id")" "$(svc_label "$id")"; } || true
        done
    fi
    local id
    for id in "${targets[@]}"; do
        svc_down "$id"
        svc_up "$id"
    done
    elapsed=$(( $(date +%s) - started ))
    report_ready "$elapsed" || true
}

# ---------------------------------------------------------------- reporte

# Devuelve 0 sólo si los servicios con health responden y el resto escucha; así
# no se abre una pestaña pensando mientras el dev server compila.
report_ready() {
    local elapsed=$1 bad="" id port health
    for id in $(svc_ids); do
        port=$(svc_port "$id")
        health=$(svc_field "$id" health)
        if [[ -n $health ]]; then
            http_ok "$health" 5 || bad="$bad $(svc_label "$id")"
        elif [[ -n $port ]]; then
            port_open "$port" || bad="$bad $(svc_label "$id")"
        fi
    done
    if [[ -n $bad ]]; then
        warn "Faltó:$bad (${elapsed}s). Mirá 'devstack $CURRENT status' y los logs"
        notify_result "Stack parcial en ${elapsed}s: falta$bad"
        return 1
    fi
    local web
    web=$(open_service)
    if [[ -n $web ]]; then
        local url
        url=$(svc_field "$web" health)
        [[ -n $url ]] || url=$(svc_field "$web" url)
        if [[ -n $url ]] && ! http_ok "$url" 5; then
            ok "Stack arriba en ${elapsed}s ($(svc_label "$web") todavía no contesta la 1ª ruta)"
            notify_result "Stack arriba en ${elapsed}s: abrí $url cuando responda"
            return 1
        fi
    fi
    ok "Stack arriba en ${elapsed}s"
    notify_result "Stack arriba en ${elapsed}s"
    return 0
}

# Servicio que define el navegador: el que tenga "open": true, o el último.
open_service() {
    local id
    while IFS= read -r id; do
        [[ $(svc_field "$id" open) == true ]] && { printf '%s' "$id"; return 0; }
    done < <(svc_ids)
    svc_ids | tail -1
}

svc_url() {
    local id=$1 u
    u=$(svc_field "$id" url)
    if [[ -z $u ]]; then
        u=$(svc_field "$id" health)
    fi
    printf '%s' "$u"
}

open_url() {
    local id=$1 url
    [[ -n $id ]] || return 0
    url=$(svc_url "$id")
    [[ -n $url ]] || die "El servicio '$id' no declara url"
    log "Abriendo $url"
    if command -v omarchy-launch-browser >/dev/null 2>&1; then
        omarchy-launch-browser "$url" >/dev/null 2>&1 &
    else
        xdg-open "$url" >/dev/null 2>&1 &
    fi
}

print_urls() {
    local id url
    for id in $(svc_ids); do
        url=$(svc_url "$id")
        printf '  %-12s %s\n' "$(svc_label "$id")" "${url:-(sin url)}"
    done
}

svc_state() {
    local id=$1 port health up healthy managed
    port=$(svc_port "$id")
    health=$(svc_field "$id" health)
    if [[ -n $port ]] && port_open "$port"; then up=true; else up=false; fi
    if [[ -n $health ]] && http_ok "$health" 5; then healthy=true; else healthy=false; fi
    if managed_process "$id"; then managed=true; else managed=false; fi
    printf '%s' "{\"id\":\"$(svc_field "$id" id)\",\"label\":\"$(svc_label "$id")\",\"type\":\"$(svc_type "$id")\",\"port\":${port:-0},\"up\":$up,\"healthy\":$healthy,\"managed\":$managed,\"health\":\"$health\",\"url\":\"$(svc_url "$id")\"}"
}

json_status() {
    local first=1 id out=""
    for id in $(svc_ids); do
        [[ $first == 1 ]] || out="$out,"
        first=0
        out="$out$(svc_state "$id")"
    done
    printf '{"project":"%s","name":"%s","dir":"%s","services":[%s],"open":"%s"}\n' \
        "$CURRENT" "$DEVDATA_NAME" "$DIR" "$out" "$(open_service)"
}

status() {
    printf '%s — %s\n' "$DEVDATA_NAME" "$DIR"
    local id port health label type st owner cname
    for id in $(svc_ids); do
        label=$(svc_label "$id")
        port=$(svc_port "$id")
        type=$(svc_type "$id")
        health=$(svc_field "$id" health)
        if [[ -z $port ]] || ! port_open "$port"; then
            printf '  %-12s %-6s %s\n' "$label" "${port:+:$port}" "detenido"
            continue
        fi
        if [[ -n $health ]]; then
            if http_ok "$health" 4; then st="respondiendo"; else st="puerto abierto"; fi
        else
            st="escuchando"
        fi
        if [[ $type == docker ]]; then
            # El contenedor puede ser ajeno (ya estaba arriba): sin nombre no se
            # muestra el paréntesis, que quedaba como "(contenedor: )".
            cname=$(container_status "$id")
            [[ -n $cname ]] && st="$st (contenedor: $cname)"
        elif managed_process "$id"; then
            st="$st (gestionado, pid $(<"$(svc_pidfile "$id")"))"
        else
            owner=$(port_owner "$port")
            st="$st (ajeno${owner:+, pid $owner})"
        fi
        printf '  %-12s %-6s %s\n' "$label" ":$port" "$st"
    done
    print_urls
    printf '  %-12s %s\n' "logs" "$RUNTIME_DIR"
}

logs() {
    local what="${1:-}" logfile
    if [[ -z $what ]]; then
        local id
        for id in $(svc_ids); do tail_log "$(svc_logfile "$id")"; done
        printf '  seguí uno con: devstack %s logs <id>\n' "$CURRENT" >&2
        return 0
    fi
    [[ -n $(svc_field "$what" id) ]] || die "No existe el servicio '$what' (mirá 'devstack $CURRENT list')"
    [[ $(svc_type "$what") == docker ]] && { compose_logs "$what" | tail -n 200 -f; return 0; }
    logfile=$(svc_logfile "$what")
    [[ -r $logfile ]] || die "Todavía no hay log de $(svc_label "$what") ($logfile): el servicio no arrancó"
    tail -n 200 -f "$logfile"
}

run_task() {
    local task=$1 dir cmd
    [[ -n $task ]] || die "task: falta el id"
    dir=$(jq -r --arg id "$task" '.tasks[]? | select(.id == $id) | .dir // empty' "$CONFIG_FILE")
    cmd=$(jq -r --arg id "$task" '.tasks[]? | select(.id == $id) | .cmd // empty' "$CONFIG_FILE")
    [[ -n $cmd ]] || die "No existe la tarea '$task' (mirá 'devstack $CURRENT list')"
    local d
    d=$(join_dir "$DIR" "$dir")
    local need
    while IFS= read -r need; do
        [[ -n $need ]] && svc_up "$need"
    done < <(jq -r --arg id "$task" '.tasks[]? | select(.id == $id) | .needs[]?' "$CONFIG_FILE")
    log "Tarea $task: $cmd"
    ( cd "$d" && bash -lc "$cmd" )
}

list_all() {
    printf '%s (%s)\n' "$DEVDATA_NAME" "$DIR"
    local id
    for id in $(svc_ids); do
        printf '  servicio  %-12s %s\n' "$id" "$(svc_field "$id" cmd)$(svc_field "$id" compose)"
    done
    while IFS=$'\t' read -r tid tlabel tcmd; do
        [[ -n $tid ]] && printf '  tarea     %-12s %s\n' "$tid" "${tlabel:-$tcmd}"
    done < <(jq -r '.tasks[]? | "\(.id)\t\(.label // "")\t\(.cmd)"' "$CONFIG_FILE")
}

# Nombre de proyecto a partir de un directorio (sin guiones sobrantes).
sanitize_name() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._-' '-' | sed -e 's/^-\{1,\}//' -e 's/-\{1,\}$//'
}

# --- contexto: "¿en qué proyecto estoy parado?" ------------------------------
# Proyecto declarado que contiene esa ruta (gana el directorio más largo).
project_for_path() {
    local path=$1 dir f name best="" best_len=0 cdir
    path=$(cd "$path" 2>/dev/null && pwd) || return 1
    # Ojo: `"${arr[@]}"/*.json` sólo glob-ea el ÚLTIMO elemento del array; hay
    # que anidar los bucles por directorio.
    # Los ejemplos que viajan con el plugin (demo, example) NO cuentan como
    # "proyecto donde estás parado": sirven para probar, no para resolver rutas.
    local dirs=("$USER_CONFIG_DIR")
    [[ -n ${DEVDATA_CONFIG:-} ]] && dirs=("$DEVDATA_CONFIG" "$USER_CONFIG_DIR")
    for cdir in "${dirs[@]}"; do
        for f in "$cdir"/*.json; do
            [[ -r $f ]] || continue
            dir=$(jq -r '.dir // empty' "$f" 2>/dev/null)
            [[ -n $dir ]] || continue
            dir="${dir/#\~/$HOME}"
            dir=$(cd "$dir" 2>/dev/null && pwd) || continue
            case $path in
                "$dir" | "$dir"/*)
                    if (( ${#dir} > best_len )); then
                        best_len=${#dir}
                        best=$(basename "$f" .json)
                    fi
                    ;;
            esac
        done
    done
    [[ -n $best ]] && printf '%s' "$best" || return 1
}

# Ruta de referencia: la terminal activa (--window) o el directorio actual.
# Cwd de un pid y de sus descendientes (hasta 3 niveles). Omarchy sólo resuelve
# el terminal activo para kitty (socket) o cuando el hijo es un shell listado en
# /etc/shells; con ghostty devolvía $HOME y el foco nunca resolvía.
pid_cwds() {
    local pid=$1 depth=${2:-3} child
    [[ -n $pid && -d /proc/$pid ]] || return 0
    readlink -f "/proc/$pid/cwd" 2>/dev/null
    ((depth > 0)) || return 0
    for child in $(pgrep -P "$pid" 2>/dev/null); do
        pid_cwds "$child" "$((depth - 1))"
    done
}

# Cwd de la ventana activa, buscando en su árbol de procesos un directorio que
# sea de un proyecto declarado. Vacío si no hay nada útil: así no inventamos un
# proyecto a partir del directorio de la ventana equivocada.
window_cwd() {
    command -v hyprctl >/dev/null 2>&1 || return 0
    command -v jq >/dev/null 2>&1 || return 0
    local pid cwd
    pid=$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid // empty' 2>/dev/null)
    [[ -n $pid ]] || return 0
    while IFS= read -r cwd; do
        [[ -n $cwd && -d $cwd ]] || continue
        if project_for_path "$cwd" >/dev/null 2>&1; then
            printf '%s' "$cwd"
            return 0
        fi
    done < <(pid_cwds "$pid")
    return 0
}

reference_path() {
    if [[ ${1:-} == --window ]]; then
        # Con Hyprland: ventana activa -> árbol de procesos -> lo que diga
        # Omarchy. Si la ventana no es un terminal, $HOME = "ningún proyecto".
        if command -v hyprctl >/dev/null 2>&1; then
            local cwd
            cwd=$(window_cwd)
            if [[ -n $cwd ]]; then
                printf '%s' "$cwd"
                return 0
            fi
            if command -v omarchy-cmd-terminal-cwd >/dev/null 2>&1; then
                cwd=$(omarchy-cmd-terminal-cwd 2>/dev/null)
                if [[ -d $cwd && $cwd != "$HOME" ]]; then
                    printf '%s' "$cwd"
                    return 0
                fi
            fi
            printf '%s' "$HOME"
            return 0
        fi
        # Sin Hyprland (CI, otra sesión): no hay ventana que mirar, vale el $PWD.
    fi
    printf '%s' "$PWD"
}

# Raíz del repo (o la ruta misma si no es un repo de git).
repo_root_of() {
    local path=$1 root
    root=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)
    [[ -n $root ]] && {
        printf '%s' "$root"
        return 0
    }
    printf '%s' "$path"
}

# ¿hay algo que valga la pena declarar acá? (si no, no ofrecemos nada)
looks_like_repo() {
    local root=$1
    [[ -d $root/.git ]] && return 0
    local m
    for m in package.json pyproject.toml requirements.txt go.mod Cargo.toml Gemfile composer.json \
        manage.py docker-compose.yml compose.yml docker-compose.yaml compose.yaml; do
        [[ -e $root/$m ]] && return 0
    done
    return 1
}

# devstack here [json|status|<subcomando>] [--window] [--fallback <proyecto>]
# El proyecto de la terminal activa (--window, para el widget) o el del $PWD
# (para un atajo de teclado: "levantá el stack de donde estoy parado").
# Con --fallback, si el foco no está en un repo declarado se responde con ese
# proyecto en la MISMA pasada: el widget no necesita una segunda sonda (que se
# pisaba con ésta y dejaba el estado en blanco entre sondeo y sondeo).
here() {
    local sub=json use_window="" fallback="" use_default=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            --window) use_window=--window ;;
            --default) use_default=1 ;;
            --fallback)
                shift
                fallback=${1:-}
                [[ -n $fallback ]] || die "here: --fallback necesita un nombre de proyecto"
                ;;
            -*) die "here: opción desconocida $1" ;;
            *) sub=$1 ;;
        esac
        shift
    done
    local cwd repo project suggested inner
    cwd=$(reference_path "$use_window")
    repo=$(repo_root_of "$cwd")
    if project=$(project_for_path "$cwd"); then
        if [[ $sub == json ]]; then
            inner=$("$0" "$project" json)
            printf '%s' "$inner" | jq -c --arg p "$project" --arg cwd "$cwd" --arg repo "$repo" \
                '. + {mode:"auto",declared:true,project:$p,cwd:$cwd,repo:$repo}'
        else
            exec "$0" "$project" "$sub"
        fi
        return 0
    fi
    # El foco no resolvió a un proyecto declarado: respaldo del ajuste y, si no,
    # el proyecto de casa (`devstack use`). Todo en esta pasada.
    local candidate=""
    if [[ -n $fallback ]] && project_file "$fallback" >/dev/null 2>&1; then
        candidate=$fallback
    elif [[ -n $use_default ]]; then
        candidate=$(default_project) || candidate=""
    fi
    if [[ -n $candidate ]]; then
        if [[ $sub == json ]]; then
            if inner=$("$0" "$candidate" json 2>/dev/null); then
                printf '%s' "$inner" | jq -c --arg p "$candidate" --arg cwd "$cwd" --arg repo "$repo" \
                    '. + {mode:"auto",declared:true,fallback:true,project:$p,cwd:$cwd,repo:$repo}'
                return 0
            fi
        else
            exec "$0" "$candidate" "$sub"
        fi
    fi
    [[ -n $(printf '%s' "$repo") ]] || repo=""
    if [[ -z $repo || ! -d $repo ]] || ! looks_like_repo "$repo"; then
        # No hay nada que declarar (p. ej. estás en $HOME): estado neutro.
        if [[ $sub == json ]]; then
            printf '{"mode":"auto","declared":false,"project":"","name":"","repo":"","cwd":"%s","suggested":"","services":[],"open":"","urls":{}}\n' "$cwd"
            return 0
        fi
        [[ $sub == status ]] && printf 'Sin proyecto para %s\n' "$cwd" && return 0
        die "No hay ningún proyecto declarado para $cwd"
    fi
    suggested=$(sanitize_name "$(basename "$repo")")
    case $sub in
        json)
            printf '{"mode":"auto","declared":false,"project":"","name":"%s","repo":"%s","cwd":"%s","suggested":"%s","services":[],"open":"","urls":{}}\n' \
                "$(basename "$repo")" "$repo" "$cwd" "$suggested"
            ;;
        status)
            printf 'Sin declarar: %s\n  repo: %s\n  → devstack add %s\n' "$(basename "$repo")" "$repo" "$repo"
            ;;
        *)
            die "Ese repo todavía no está declarado ($repo). Corré: devstack add $repo"
            ;;
    esac
}

# --- vista global (todos TUS proyectos) --------------------------------------
# Sólo los proyectos del usuario: los ejemplos que viajan con el plugin no son
# "tus" stacks (no entran en `all` ni en la resolución de `here`).
list_user_projects() {
    local f
    for f in "$USER_CONFIG_DIR"/*.json; do
        [[ -r $f ]] || continue
        basename "$f" .json
    done
}

# Estado resumido de un proyecto (una línea JSON).
# Puertos declarados por más de un proyecto tuyo: se pisan entre sí (y entonces
# el "arriba" de uno puede ser el proceso del otro).
port_clashes() {
    local p f port
    for p in $(list_user_projects); do
        f=$(project_file "$p") || continue
        while IFS= read -r port; do
            [[ -n $port && $port != 0 ]] || continue
            printf '%s\t%s\n' "$port" "$p"
        done < <(jq -r '.services[]? | (.port // empty)' "$f" 2>/dev/null)
    done | sort -n | awk -F'\t' '{owners[$1] = owners[$1] " " $2; n[$1]++}
        END { for (p in n) if (n[p] > 1) printf "  :%s  lo declaran:%s\n", p, owners[p] }' | sort
}

project_snapshot() {
    local p=$1 inner
    inner=$("$0" "$p" json 2>/dev/null) || return 1
    printf '%s' "$inner" | jq -c '{project: .project, name: .name, dir: .dir,
        up: ([.services[] | select(.up)] | length),
        total: (.services | length),
        allUp: (([.services[] | select(if .health != "" then .healthy else .up end)] | length) == (.services | length)),
        services: [.services[] | {id: .id, label: .label, port: .port, up: .up, healthy: .healthy}]}'
}

# devstack all [json|status|up|down]
all_cmd() {
    local sub=${1:-status} p s
    local projects=() snaps=()
    while IFS= read -r p; do [[ -n $p ]] && projects+=("$p"); done < <(list_user_projects)
    if [[ ${#projects[@]} -eq 0 ]]; then
        die "No hay proyectos declarados (devstack add <dir> o devstack init <nombre>)"
    fi
    case $sub in
        json)
            for p in "${projects[@]}"; do
                s=$(project_snapshot "$p") || continue
                snaps+=("$s")
            done
            printf '[%s]\n' "$(printf '%s\n' "${snaps[@]:-}" | grep -v '^$' | paste -sd, -)"
            ;;
        status)
            printf '%-14s %-18s %-7s %s\n' PROYECTO NOMBRE ARRIBA ESTADO
            for p in "${projects[@]}"; do
                s=$(project_snapshot "$p") || continue
                printf '%-14s %-18s %-7s %s\n' "$p" \
                    "$(printf '%s' "$s" | jq -r .name)" \
                    "$(printf '%s' "$s" | jq -r '"\(.up)/\(.total)"')" \
                    "$(printf '%s' "$s" | jq -r '[.services[] | (if .healthy then "✓" elif .up then "~" else "·" end)] | join("")')"
            done
            # Puertos compartidos: el "arriba" de un proyecto puede ser el
            # proceso del otro (dos proyectos en :3000 se contestan cruzado).
            local clashes
            clashes=$(port_clashes)
            [[ -n $clashes ]] && printf '\n\033[1;33m[aviso]\033[0m  puertos compartidos entre proyectos:\n%s\n' "$clashes"
            ;;
        up)
            local failed=0
            for p in "${projects[@]}"; do
                log "— $p"
                "$0" "$p" up || failed=1
            done
            ((failed)) && die "Algún proyecto no quedó arriba (mirá 'devstack all status')"
            notify_result "Todos los stacks arriba"
            ;;
        down)
            local i
            for ((i = ${#projects[@]} - 1; i >= 0; i--)); do
                "$0" "${projects[$i]}" down
            done
            notify_result "Todos los stacks detenidos"
            ;;
        *) die "all: usá json|status|up|down" ;;
    esac
}

# --- detección (scan/add) ---------------------------------------------------
require_scan() {
    [[ -n $SCAN_LIB ]] || die "scan/add necesitan lib/scan.sh: usá el CLI que viene dentro del plugin (o instalá con ./install.sh)"
    [[ -n ${SCAN_LOADED:-} ]] && return 0
    # shellcheck source=/dev/null
    source "$SCAN_LIB"
    SCAN_LOADED=1
    command -v jq >/dev/null || die "scan/add necesitan jq"
}

# devstack scan [dir] [--json]
scan_cmd() {
    local dir="." opt=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            --json) opt=--json ;;
            -*) die "scan: opción desconocida $1" ;;
            *) dir=$1 ;;
        esac
        shift
    done
    [[ -d $dir ]] || die "No existe el directorio: $dir"
    require_scan
    local root out json
    root=$(cd "$dir" && pwd)
    out=$(scan_project_json "$root" "") || die "No pude analizar $root"
    json=$(printf '%s\n' "$out" | grep -v '^#')
    if [[ $opt == --json ]]; then
        printf '%s\n' "$json"
        return 0
    fi
    printf '%s — %s\n' "$(printf '%s' "$json" | jq -r .name)" "$(printf '%s' "$json" | jq -r .dir)"
    if [[ $(printf '%s' "$json" | jq '.services | length') -eq 0 ]]; then
        warn "No reconocí ningún stack en ese directorio"
    else
        printf '  servicios propuestos:\n'
        printf '%s' "$json" | jq -r '.services[] | "    \(.id)\t\(.type)\t\(.dir // "")\t\(.cmd // .compose)\t:\(.port)\t\(.health // "")"' | column -t -s$'\t' | sed 's/^/  /'
    fi
    if [[ $(printf '%s' "$json" | jq '.tasks | length // 0') -gt 0 ]]; then
        printf '  tareas:\n'
        printf '%s' "$json" | jq -r '.tasks[] | "    \(.id)\t\(.cmd)"' | column -t -s$'\t' | sed 's/^/  /'
    fi
    printf '%s\n' "$out" | sed -n 's/^#\( evidencias\| comandos.*\)$/  \1/p'
    printf '%s\n' "$out" | sed -n '/^#   /s/^#   /    /p'
    printf '  → para declararlo:  devstack add %s\n' "$dir"
}

# devstack add [dir] [--name NOMBRE] [--force]
add_cmd() {
    local dir="." name="" force=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            --force) force=1 ;;
            --name=*) name=${1#--name=} ;;
            --name)
                name="${2:-}"
                shift
                ;;
            -*) die "add: opción desconocida $1" ;;
            *) dir=$1 ;;
        esac
        shift
    done
    [[ -d $dir ]] || die "No existe el directorio: $dir"
    require_scan
    local root json
    root=$(cd "$dir" && pwd)
    if [[ -z $name ]]; then
        # sin el \n final: tr -c lo convertía en un guión al final del nombre
        name=$(sanitize_name "$(basename "$root")")
    fi
    [[ $name =~ ^[a-zA-Z0-9._-]+$ ]] || die "Nombre inválido: $name"
    json=$(scan_project_json "$root" "" | grep -v '^#') || die "No pude analizar $root"
    [[ $(printf '%s' "$json" | jq '.services | length') -gt 0 ]] ||
        die "No reconocí ningún stack en $root (probá 'devstack init $name' y editarlo a mano)"
    mkdir -p "$USER_CONFIG_DIR"
    local target="$USER_CONFIG_DIR/$name.json"
    if [[ -e $target && -z $force ]]; then
        # Repetir el mismo `add` sobre el mismo directorio no es un conflicto:
        # es la misma declaración (pasa al volver a elegir un candidato que ya
        # habías declarado). Conflictúa sólo si ese nombre apunta a otro lado.
        local have_dir
        have_dir=$(jq -r '.dir // empty' "$target" 2>/dev/null)
        have_dir="${have_dir/#\~/$HOME}"
        have_dir=$(cd "$have_dir" 2>/dev/null && pwd) || have_dir="${have_dir%/}"
        if [[ -n $have_dir && $have_dir == "$root" ]]; then
            ok "Ya estaba declarado: $name ($root) — seguí con 'devstack $name up'"
            return 0
        fi
        die "El nombre '$name' ya está tomado por $target (declara ${have_dir:-otro directorio}): usá --force para pisarlo, o --name <otro> para declarar este directorio con otro nombre"
    fi
    # ¿ese mismo directorio ya está declarado con otro nombre? Es el error fácil
    # (declarar dos veces el mismo repo porque el nombre no coincidía).
    local f existing="" cfg_dir
    for f in "$USER_CONFIG_DIR"/*.json; do
        [[ -r $f ]] || continue
        cfg_dir=$(jq -r '.dir // empty' "$f" 2>/dev/null)
        cfg_dir="${cfg_dir/#\~/$HOME}"
        if [[ -n $cfg_dir && $cfg_dir == "$root" ]]; then
            existing=$(basename "$f" .json)
            break
        fi
    done
    if [[ -n $existing && $existing != "$name" && -z $force ]]; then
        die "Ese directorio ya está declarado como '$existing' ($USER_CONFIG_DIR/$existing.json); usá --force si querés otro nombre"
    fi
    printf '%s\n' "$json" | jq . >"$target"
    ok "Proyecto $name declarado en $target"
    printf '%s' "$json" | jq -r '.services[] | "    \(.id)  \(.cmd // .compose)  :\(.port)"'
    printf '  revisalo y después:  devstack %s up\n' "$name"
}

# Crea un proyecto nuevo a partir del ejemplo que viaja con el plugin.
init_project() {
    local name=$1 target example
    [[ -n $name ]] || die "init: falta el nombre (devstack init mi-app)"
    [[ $name =~ ^[a-zA-Z0-9._-]+$ ]] || die "init: nombre inválido '$name'"
    mkdir -p "$USER_CONFIG_DIR"
    target="$USER_CONFIG_DIR/$name.json"
    [[ -e $target ]] && die "Ya existe $target"
    example=""
    [[ -r $BUNDLED_CONFIG_DIR/example.json ]] && example="$BUNDLED_CONFIG_DIR/example.json"
    [[ -n $example ]] || die "No encuentro el ejemplo en $BUNDLED_CONFIG_DIR"
    cp "$example" "$target"
    ok "Proyecto creado: $target"
    printf '  %s\n' "editá \"dir\" y los servicios, y después: devstack $name up"
}

# Bloque JSONC para pegar en ~/.config/omarchy/extensions/omarchy-menu.jsonc.
# Se arma con jq para que el escapado de las acciones sea correcto por
# construcción (cada action termina envuelta en '...' para bash -lc).
menu_block() {
    local prefix=${1:-dev} base
    base="${prefix}.${CURRENT}"
    jq -c --arg base "$base" --arg p "$CURRENT" --arg name "$DEVDATA_NAME" '
      def term($cmd): "omarchy-launch-terminal bash -lc " + ($cmd | @sh);
      . as $cfg
      | {
          ($base): {icon: "", label: $name},
          ($base + ".up"): {icon: "󰐊", label: "Levantar", when: ("! devstack " + $p + " --running"), action: term("devstack " + $p + " up || read -r")},
          ($base + ".status"): {icon: "󱆃", label: "Estado", action: term("devstack " + $p + " status; read -r")},
          ($base + ".open"): {icon: "󰖟", label: "Abrir en el navegador", checked: ("devstack " + $p + " --running"), action: ("devstack " + $p + " open")},
          ($base + ".restart"): {icon: "󰜉", label: "Reiniciar", action: term("devstack " + $p + " restart || read -r")},
          ($base + ".takeover"): {icon: "󰒓", label: "Tomar el control de puertos ajenos", when: ("devstack " + $p + " --foreign"), action: term("devstack " + $p + " up --force || read -r")},
          ($base + ".down"): {icon: "󰍃", label: "Bajar", when: ("devstack " + $p + " --up"), action: term("devstack " + $p + " down || read -r")},
          ($base + ".logs"): {icon: "", label: "Logs"}
        }
      + (reduce ($cfg.services[]) as $s ({}; . + {
            ($base + ".logs." + $s.id): {icon: "", label: ($s.label // $s.id), action: term("devstack " + $p + " logs " + $s.id)}
          }))
      + (if (($cfg.tasks // []) | length) > 0 then
           {($base + ".tasks"): {icon: "", label: "Tareas"}}
           + (reduce ($cfg.tasks[]) as $t ({}; . + {
                ($base + ".tasks." + $t.id): {icon: "", label: ($t.label // $t.id), action: term("devstack " + $p + " task " + $t.id + " || read -r")}
              }))
         else {} end)
    ' "$CONFIG_FILE" | jq -r 'to_entries[] | "  \"\(.key)\": \(.value | tojson),"'
}

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

# ---------------------------------------------------------------- dispatch

KNOWN_COMMANDS=" up down restart status json logs open task list menu init use find --running --up --foreign "

[[ $# -gt 0 ]] || {
    list_projects
    exit 0
}

case "$1" in
    -h | --help | help)
        usage
        exit 0
        ;;
    list)
        # `devstack list` sin más lista los proyectos; con proyecto, sus servicios.
        if [[ $# -eq 1 ]]; then
            list_projects
            exit 0
        fi
        ;;
    init)
        init_project "${2:-}"
        exit 0
        ;;
    scan)
        scan_cmd "${@:2}"
        exit 0
        ;;
    here)
        here "${@:2}"
        exit 0
        ;;
    use)
        use_cmd "${2:-}"
        exit 0
        ;;
    find)
        find_cmd "${@:2}"
        exit 0
        ;;
    all)
        all_cmd "${@:2}"
        exit 0
        ;;
    add)
        add_cmd "${@:2}"
        exit 0
        ;;
esac

# `devstack <comando>` sin proyecto (así lo llama el widget de la barra): si el
# primer argumento es un comando conocido y no un proyecto existente, se usa el
# proyecto por defecto.
if [[ " $KNOWN_COMMANDS " == *" $1 "* ]] && ! project_file "$1" >/dev/null 2>&1; then
    CMD="$1"
    PROJECT_ARG=""
    shift
else
    PROJECT_ARG="$1"
    CMD="${2:-up}"
    [[ $# -gt 1 ]] && shift 2 || shift 1
fi

load_project "$PROJECT_ARG"

case "$CMD" in
    up) up "$@" ;;
    down) down "$@" ;;
    restart) restart "$@" ;;
    status) status ;;
    json) json_status ;;
    logs) logs "${1:-}" ;;
    open) open_url "${1:-$(open_service)}" ;;
    task) run_task "${1:-}" ;;
    list) list_all ;;
    menu) menu_block "${1:-dev}" ;;
    --running)
        rc=0
        for id in $(svc_ids); do
            h=$(svc_field "$id" health)
            [[ -n $h ]] && { http_ok "$h" || rc=1; }
        done
        exit $rc
        ;;
    --up)
        rc=0
        for id in $(svc_ids); do
            p=$(svc_port "$id")
            [[ -n $p ]] && { port_open "$p" || rc=1; }
        done
        exit $rc
        ;;
    --foreign)
        rc=1
        for id in $(svc_ids); do
            p=$(svc_port "$id")
            [[ -n $p ]] || continue
            if port_open "$p" && ! managed_process "$id" && [[ $(svc_type "$id") != docker ]]; then rc=0; fi
        done
        exit $rc
        ;;
    -h | --help | help) usage ;;
    *)
        # Un id de servicio como comando: levanta sólo ese.
        if [[ -n $(svc_field "$CMD" id) ]]; then
            svc_up "$CMD"
        else
            usage >&2
            die "Comando desconocido: $CMD"
        fi
        ;;
esac
