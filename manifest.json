{
  "schemaVersion": 1,
  "id": "meperdonas.devstack",
  "name": "devstack",
  "version": "1.10.0",
  "author": "Santiago Villabona (MeperDonas)",
  "license": "MIT",
  "description": "One bar icon per local dev stack: lift, watch and drop docker services and dev servers, in order, with a four-colour state, a take-over button for ports held by stray processes, and a detector that proposes the stack of any repository.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "devstack",
    "description": "Local dev stacks (docker + dev servers) with four-colour state and take-over of stray ports.",
    "category": "Development",
    "aliases": [
      "devstack",
      "dev-stack",
      "local stack",
      "dev servers"
    ],
    "allowMultiple": true,
    "defaultSection": "right",
    "defaults": {
      "project": "",
      "command": "",
      "refreshIntervalSec": 5,
      "stuckAfterPolls": 6,
      "pendingTimeoutSec": 300,
      "colorOff": "#7A8394",
      "colorError": "#E05561",
      "colorWorking": "#E5B454",
      "colorOk": "#7FBF7F",
      "notifyMode": "final",
      "mode": "auto"
    },
    "schema": [
      {
        "key": "mode",
        "type": "enum",
        "label": "Which project",
        "options": [
          "auto",
          "all",
          "fixed"
        ],
        "defaultValue": "auto",
        "description": "auto: follow the terminal you are looking at. all: one icon summarising every project. fixed: always the project below."
      },
      {
        "key": "project",
        "type": "string",
        "label": "Project",
        "defaultValue": "",
        "description": "Project used in fixed mode, or as fallback when auto finds nothing."
      },
      {
        "key": "command",
        "type": "string",
        "label": "devstack command",
        "defaultValue": "",
        "description": "Empty = the CLI that ships inside the plugin (falling back to `devstack` on PATH). Set it only to point somewhere else."
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 60,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "stuckAfterPolls",
        "type": "integer",
        "label": "Polls before a service counts as stuck",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 6
      },
      {
        "key": "pendingTimeoutSec",
        "type": "integer",
        "label": "Give up on an action after (seconds)",
        "min": 30,
        "max": 3600,
        "step": 10,
        "defaultValue": 300
      },
      {
        "key": "notifyMode",
        "type": "enum",
        "label": "Desktop notifications",
        "options": [
          "final",
          "all",
          "off"
        ],
        "defaultValue": "final",
        "description": "final: only the outcome (the panel already shows progress). all: every stage. off: none."
      },
      {
        "key": "colorOff",
        "type": "string",
        "label": "Colour · off",
        "defaultValue": "#7A8394"
      },
      {
        "key": "colorError",
        "type": "string",
        "label": "Colour · error",
        "defaultValue": "#E05561"
      },
      {
        "key": "colorWorking",
        "type": "string",
        "label": "Colour · working",
        "defaultValue": "#E5B454"
      },
      {
        "key": "colorOk",
        "type": "string",
        "label": "Colour · ok",
        "defaultValue": "#7FBF7F"
      }
    ]
  }
}
